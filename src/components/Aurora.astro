---
/**
 * Fixed backdrop behind every page: slowly drifting aurora blobs, film grain,
 * and a soft glow that follows the mouse (driven by scripts/motion.ts).
 */
---

<div class="aurora" aria-hidden="true">
  <div class="aurora-blob aurora-blob--a"></div>
  <div class="aurora-blob aurora-blob--b"></div>
  <div class="aurora-blob aurora-blob--c"></div>
  <div class="aurora-blob aurora-blob--d"></div>
  <div class="aurora-cursor" data-cursor-glow></div>
  <div class="aurora-noise"></div>
</div>
