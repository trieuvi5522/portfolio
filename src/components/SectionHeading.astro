---
import Kicker from "./Kicker.astro";

/** Kicker / index + split-reveal title + optional description, used to open page sections */
interface Props {
  kicker?: string;
  /** Mono section number, e.g. "01" */
  index?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}
const { kicker, index, title, description, align = "left" } = Astro.props;
const center = align === "center";
---

<div class:list={["max-w-2xl", center && "mx-auto text-center"]}>
  {
    (kicker || index) && (
      <div data-reveal="fade" class:list={["mb-5 flex items-center gap-3", center && "justify-center"]}>
        {index && (
          <>
            <span class="font-mono text-xs font-semibold tracking-widest text-accent">{index}</span>
            <span class="h-px w-10 bg-gradient-to-r from-accent/60 to-transparent" aria-hidden="true" />
          </>
        )}
        {kicker && <Kicker text={kicker} />}
      </div>
    )
  }
  <h2 data-split class="text-3xl font-semibold leading-[1.08] tracking-[-0.03em] text-balance sm:text-4xl lg:text-[2.75rem]">
    {title}
  </h2>
  {description && <p data-reveal class="mt-4 text-base leading-relaxed text-muted sm:text-lg">{description}</p>}
</div>
