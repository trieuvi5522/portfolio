---
import type { Locale } from "../data/types";
import { site, whatsappUrl, mailtoUrl } from "../data/site";
import { useTranslations } from "../i18n/utils";
import SectionHeading from "./SectionHeading.astro";
import ContactCard from "./ContactCard.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="contact"
  class="relative isolate scroll-mt-28 overflow-hidden rounded-[2rem] border border-glass-border bg-glass p-6 shadow-[var(--shadow-card)] backdrop-blur-xl sm:p-10 lg:p-14"
>
  {/* Inner aurora + grid */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -left-24 -top-32 h-80 w-80 rounded-full bg-accent/25 blur-3xl"></div>
    <div class="absolute -bottom-40 -right-16 h-96 w-96 rounded-full bg-accent-2/20 blur-3xl"></div>
    <div class="hero-grid absolute inset-0 opacity-70"></div>
  </div>

  <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-14">
    <div>
      <SectionHeading kicker={t("contact.kicker")} title={t("contact.title")} description={t("contact.desc")} />
      <div data-reveal class="mt-8 space-y-5">
        <p class="max-w-md text-sm leading-relaxed text-muted">{t("contact.availability")}</p>
        <div class="inline-flex flex-wrap items-center gap-x-3 gap-y-1 rounded-full border border-glass-border bg-glass px-4 py-2">
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
          </span>
          <span class="text-xs text-muted">{t("contact.localTime")}</span>
          <time data-local-clock class="font-mono text-xs font-semibold tabular-nums text-fg">GMT+7</time>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2" data-spotlight-group>
      <ContactCard
        href={mailtoUrl}
        label={t("contact.email")}
        value={site.email}
        note={t("contact.emailNote")}
        copyable
        copyLabel={t("contact.copy")}
        copiedLabel={t("contact.copied")}
      >
        <svg slot="icon" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </ContactCard>

      <ContactCard
        href={whatsappUrl}
        label={t("contact.whatsapp")}
        value={site.whatsappDisplay}
        note={t("contact.whatsappNote")}
        external
      >
        <svg slot="icon" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
      </ContactCard>

      <ContactCard
        href={site.linkedinUrl}
        label={t("contact.linkedin")}
        value="trieu-vi-nguyen"
        note={t("contact.linkedinNote")}
        external
      >
        <svg slot="icon" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect width="4" height="12" x="2" y="9"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </ContactCard>

      <ContactCard
        href={site.facebookUrl}
        label={t("contact.facebook")}
        value="trieu.vi"
        note={t("contact.facebookNote")}
        external
      >
        <svg slot="icon" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
        </svg>
      </ContactCard>
    </div>
  </div>
</section>

<script>
  // Live clock for the "local time in Vietnam" pill
  const clocks = document.querySelectorAll<HTMLElement>("[data-local-clock]");
  if (clocks.length) {
    const format = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
      timeZone: "Asia/Ho_Chi_Minh",
    });
    const tick = () => {
      const now = format.format(new Date());
      clocks.forEach((clock) => (clock.textContent = `${now} · GMT+7`));
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
