---
import type { Locale } from "../../data/types";
import { projects } from "../../data/projects";
import { useTranslations } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../ProjectCard.astro";
import SectionHeading from "../SectionHeading.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Summary stats computed from project data
const countryCount = new Set(projects.map((p) => p.location.en)).size;
const stats = [
  { value: `${projects.length}+`, label: t("home.statProjects") },
  { value: String(countryCount), label: t("home.statCountries") },
  { value: "6+", label: t("home.statProtocols") },
];
---

<BaseLayout lang={lang} title={t("projects.title")} description={t("projects.desc")}>
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <SectionHeading kicker={t("projects.kicker")} title={t("projects.title")} />

      <dl class="mt-8 grid max-w-lg grid-cols-3 gap-6">
        {
          stats.map((stat) => (
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd class="font-display text-3xl font-semibold text-accent">{stat.value}</dd>
              <p class="mt-1 text-xs text-muted">{stat.label}</p>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </section>
</BaseLayout>
