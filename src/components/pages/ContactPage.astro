---
import type { Locale } from "../../data/types";
import { site, whatsappUrl, mailtoUrl } from "../../data/site";
import { useTranslations } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../SectionHeading.astro";
import ContactCard from "../ContactCard.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t("contact.title")} description={t("contact.desc")}>
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
      <SectionHeading kicker={t("contact.kicker")} title={t("contact.title")} description={t("contact.desc")} />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <ContactCard
        href={mailtoUrl}
        label={t("contact.email")}
        value={site.email}
        note={t("contact.emailNote")}
        copyable
        copyLabel={t("contact.copy")}
        copiedLabel={t("contact.copied")}
      >
        <svg slot="icon" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </ContactCard>

      <ContactCard
        href={whatsappUrl}
        label={t("contact.whatsapp")}
        value={site.whatsappDisplay}
        note={t("contact.whatsappNote")}
        external
      >
        <svg slot="icon" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
      </ContactCard>

      <ContactCard
        href={site.linkedinUrl}
        label={t("contact.linkedin")}
        value="trieu-vi-nguyen"
        note={t("contact.linkedinNote")}
        external
      >
        <svg slot="icon" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect width="4" height="12" x="2" y="9"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </ContactCard>

      <ContactCard
        href={site.facebookUrl}
        label={t("contact.facebook")}
        value="trieu.vi"
        note={t("contact.facebookNote")}
        external
      >
        <svg slot="icon" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
        </svg>
      </ContactCard>
    </div>

    <p class="mt-8 rounded-lg border border-line bg-surface p-4 text-center text-sm text-muted">
      {t("contact.availability")}
    </p>
  </section>
</BaseLayout>
