---
import type { Locale } from "../../data/types";
import { projects } from "../../data/projects";
import { useTranslations, localePath } from "../../i18n/utils";
import { aboutFocus, aboutSkills, aboutProcess } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../SectionHeading.astro";
import ContactSection from "../ContactSection.astro";
import HeroBackdrop from "../HeroBackdrop.astro";
import HeroOrbit from "../HeroOrbit.astro";
import Kicker from "../Kicker.astro";
import TechMarquee from "../TechMarquee.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const focus = aboutFocus[lang];
const skills = aboutSkills[lang];
const process = aboutProcess[lang];

// Highlight the nickname inside the greeting ("… call me Luca …")
const greetingParts = t("about.greeting").split(/(Luca)/);

/** "Head: tail" expertise lines; a short comma list (the protocols line) renders as chips */
const skillItems = skills.map((skill) => {
  const [head, ...rest] = skill.split(":");
  const tail = rest.join(":").trim();
  const parts = tail.split(",").map((part) => part.trim()).filter(Boolean);
  const isList = parts.length >= 3 && !tail.endsWith(".") && parts.every((part) => part.split(/\s+/).length <= 3);
  return { head: tail ? head.trim() : skill, tail, chips: isList ? parts : undefined };
});

// Hero ticker: protocols from the expertise list + everything used across the case studies
const protocols = skillItems.find((item) => item.chips)?.chips ?? [];
const stack = [...new Set([...protocols, ...projects.flatMap((p) => p.tech)])];

// Lucide icon paths paired 1:1 with the aboutFocus items (same order in every locale)
const focusIcons = [
  // Industrial IoT Architecture & Deployment — factory
  '<path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/>',
  // Multi-Protocol Interoperability — interconnected nodes
  '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>',
  // Cloud IoT Infrastructure & Ecosystems — cloud
  '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
  // Real-time Operational Visibility & Automation — activity pulse
  '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  // Smart Home Design & Intelligent Integration — house
  '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  // Full-Lifecycle Project Delivery & Maintenance — wrench
  '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
];

const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout lang={lang} title={t("home.kicker")} description={t("about.intro1")}>
  {/* Intro hero */}
  <section data-hero class="relative isolate">
    <HeroBackdrop />
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-16 pt-12 sm:px-6 sm:pt-20 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-10 lg:pb-24 lg:pt-20">
      <div data-hero-content>
        <div data-reveal="fade">
          <Kicker text={t("home.kicker")} />
        </div>
        <h1
          data-split
          data-split-delay="0.15"
          class="mt-7 text-[2.4rem] font-semibold leading-[1.06] tracking-[-0.035em] text-balance sm:text-5xl xl:text-[3.5rem]"
        >
          {greetingParts.map((part) => (part === "Luca" ? <span class="text-gradient">{part}</span> : part))}
        </h1>
        <div data-reveal data-reveal-delay="0.35" class="mt-7 max-w-xl space-y-4 text-base leading-relaxed text-muted sm:text-lg">
          <p>{t("about.intro1")}</p>
          <p>{t("about.intro2")}</p>
        </div>
        <div data-reveal data-reveal-delay="0.5" class="mt-9 flex flex-wrap items-center gap-3">
          <a data-magnetic href={localePath("/projects", lang)} class="btn btn-primary group">
            {t("home.viewProjects")}
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a data-magnetic href="#contact" class="btn btn-ghost">
            {t("home.contactMe")}
          </a>
        </div>
      </div>

      <div class="relative mx-auto hidden w-full max-w-[34rem] lg:block">
        <HeroOrbit />
      </div>
    </div>

    <div data-reveal="fade" data-reveal-delay="0.7">
      <TechMarquee items={stack} />
    </div>
  </section>

  {/* Focus areas */}
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
    <SectionHeading index="01" title={t("about.focusTitle")} />
    <ul class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-spotlight-group>
      {
        focus.map((item, i) => (
          <li data-reveal class="h-full">
            <div data-spotlight class="card card-hover group flex h-full flex-col justify-between gap-6 p-6 sm:min-h-[11.5rem] sm:gap-8">
              <div class="flex items-start justify-between">
                <span class="inline-grid h-12 w-12 place-items-center rounded-2xl bg-accent-soft text-accent ring-1 ring-accent/20 transition-all duration-500 group-hover:bg-accent group-hover:text-white group-hover:shadow-[0_10px_30px_-8px_var(--accent)] dark:group-hover:text-bg">
                  <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={focusIcons[i]} />
                </span>
                <span class="font-mono text-xs text-muted">{pad(i + 1)}</span>
              </div>
              <h3 class="text-lg font-semibold leading-snug tracking-tight">{item}</h3>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Technical expertise */}
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <SectionHeading index="02" title={t("about.expertiseTitle")} />
      </div>
      <ul class="space-y-3" data-spotlight-group>
        {
          skillItems.map((skill, i) => (
            <li data-reveal>
              <div data-spotlight class="card flex gap-5 p-5 sm:p-6">
                <span class="mt-1 font-mono text-xs font-semibold text-accent">{pad(i + 1)}</span>
                <div class="min-w-0">
                  <h3 class="text-base font-semibold tracking-tight sm:text-lg">{skill.head}</h3>
                  {skill.chips ? (
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {skill.chips.map((chip) => (
                        <span class="chip">{chip}</span>
                      ))}
                    </div>
                  ) : (
                    skill.tail && <p class="mt-1.5 leading-relaxed text-muted">{skill.tail}</p>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Process — scroll-drawn timeline */}
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
    <SectionHeading index="03" title={t("about.processTitle")} description={t("about.processSubtitle")} align="center" />
    <div class="relative mx-auto mt-16 max-w-5xl" data-timeline>
      <div class="timeline-track left-5 md:left-1/2" aria-hidden="true">
        <div class="timeline-progress" data-timeline-progress></div>
      </div>
      <ol>
        {
          process.map((step, i) => {
            const right = i % 2 === 1;
            return (
              <li data-timeline-step class:list={["relative pl-16 md:grid md:grid-cols-2 md:pl-0", i > 0 && "mt-5 md:-mt-6"]}>
                <span class="timeline-node absolute left-0 top-5 md:left-1/2 md:-translate-x-1/2">{pad(i + 1)}</span>
                <div data-reveal={right ? "right" : "left"} class:list={[right ? "md:col-start-2 md:pl-14" : "md:pr-14 md:text-right"]}>
                  <div class="card card-hover p-6">
                    <h3 class="text-lg font-semibold tracking-tight">{step.title}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted">{step.desc}</p>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  {/* Contact */}
  <section class="mx-auto max-w-6xl px-4 pb-24 pt-8 sm:px-6 sm:pb-32">
    <ContactSection lang={lang} />
  </section>
</BaseLayout>
