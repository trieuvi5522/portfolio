---
import type { Locale } from "../../data/types";
import { useTranslations, localePath } from "../../i18n/utils";
import { aboutFocus, aboutSkills, aboutProcess } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../SectionHeading.astro";
import ContactSection from "../ContactSection.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const focus = aboutFocus[lang];
const skills = aboutSkills[lang];
const process = aboutProcess[lang];

// Lucide icon paths paired 1:1 with the aboutFocus items (same order in every locale)
const focusIcons = [
  // Industrial IoT Architecture & Deployment — factory
  '<path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/>',
  // Multi-Protocol Interoperability — interconnected nodes
  '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>',
  // Cloud IoT Infrastructure & Ecosystems — cloud
  '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
  // Real-time Operational Visibility & Automation — activity pulse
  '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  // Smart Home Design & Intelligent Integration — house
  '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  // Full-Lifecycle Project Delivery & Maintenance — wrench
  '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
];
---

<BaseLayout lang={lang} title={t("home.kicker")} description={t("about.intro1")}>
  {/* Intro hero */}
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
      <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent">{t("home.kicker")}</p>
      <h1 class="mt-3 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
        {t("about.greeting")}
      </h1>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-muted">
        <p>{t("about.intro1")}</p>
        <p>{t("about.intro2")}</p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={localePath("/projects", lang)}
          class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90 dark:text-slate-900"
        >
          {t("home.viewProjects")}
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center rounded-md border border-line px-5 py-2.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
        >
          {t("home.contactMe")}
        </a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-4xl space-y-16 px-4 py-12 sm:px-6 sm:py-16">
    {/* Focus areas */}
    <section>
      <SectionHeading title={t("about.focusTitle")} />
      <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          focus.map((item, i) => (
            <li class="flex h-full flex-col items-center gap-4 rounded-xl border border-line bg-surface p-6 text-center transition-colors hover:border-accent">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-accent-soft text-accent">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={focusIcons[i]} />
              </span>
              <span class="text-sm font-semibold leading-relaxed">{item}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {/* Technical expertise */}
    <section>
      <SectionHeading title={t("about.expertiseTitle")} />
      <ul class="mt-6 space-y-3">
        {
          skills.map((skill) => {
            const [head, ...rest] = skill.split(":");
            const tail = rest.join(":").trim();
            return (
              <li class="flex items-start gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                <p class="leading-relaxed text-muted">
                  {tail ? (
                    <>
                      <span class="font-medium text-fg">{head}:</span> {tail}
                    </>
                  ) : (
                    skill
                  )}
                </p>
              </li>
            );
          })
        }
      </ul>
    </section>

    {/* Process */}
    <section>
      <SectionHeading title={t("about.processTitle")} description={t("about.processSubtitle")} />
      <ol class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          process.map((step, i) => (
            <li class="rounded-lg border border-line bg-surface p-5">
              <span class="font-mono text-xs font-semibold text-accent">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-2 text-sm font-semibold">{step.title}</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-muted">{step.desc}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>

  {/* Contact */}
  <section class="border-t border-line">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-16">
      <ContactSection lang={lang} />
    </div>
  </section>
</BaseLayout>
