---
import { getImage } from "astro:assets";
import type { Locale, Project } from "../../data/types";
import { projects } from "../../data/projects";
import { projectImage } from "../../lib/images";
import { useTranslations, pick, localePath } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectHero from "../project/ProjectHero.astro";
import ProjectSection from "../project/ProjectSection.astro";
import ProjectToc from "../project/ProjectToc.astro";
import ResultsList from "../project/ResultsList.astro";
import TechHighlights from "../project/TechHighlights.astro";
import NextProject from "../project/NextProject.astro";
import Lightbox from "../project/Lightbox.astro";

interface Props {
  project: Project;
  lang: Locale;
}
const { project, lang } = Astro.props;
const t = useTranslations(lang);

const ogImage = await getImage({ src: projectImage(project.cover), width: 1200 });

const hasHighlights = !!project.techHighlights && project.techHighlights.length > 0;
const hasResults = project.results.length > 0;
const tocItems = [
  ...project.sections.map((section) => ({ id: section.id, label: pick(section.title, lang) })),
  ...(hasHighlights ? [{ id: "tech-highlights", label: t("project.techHighlights") }] : []),
  ...(hasResults
    ? [{ id: "results", label: project.resultsTitle ? pick(project.resultsTitle, lang) : t("project.results") }]
    : []),
];

const currentIndex = projects.findIndex((p) => p.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
---

<BaseLayout
  lang={lang}
  title={pick(project.title, lang)}
  description={pick(project.excerpt, lang)}
  ogImage={ogImage.src}
>
  <ProjectHero project={project} lang={lang} />

  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28 lg:grid lg:grid-cols-[13.5rem_minmax(0,1fr)] lg:gap-16">
    <ProjectToc items={tocItems} lang={lang} />

    <article class="min-w-0 max-w-3xl space-y-20 sm:space-y-24">
      {project.sections.map((section, i) => <ProjectSection section={section} index={i + 1} lang={lang} />)}

      {hasHighlights && (
        <TechHighlights highlights={project.techHighlights!} index={project.sections.length + 1} lang={lang} />
      )}

      {hasResults && (
        <ResultsList
          results={project.results}
          title={project.resultsTitle}
          index={project.sections.length + (hasHighlights ? 2 : 1)}
          lang={lang}
        />
      )}

      {
        project.ctaTitle && (
          <aside data-reveal class="relative isolate overflow-hidden rounded-[1.75rem] border border-glass-border p-8 sm:p-10">
            <div aria-hidden="true" class="cta-backdrop absolute inset-0 -z-10" />
            <div aria-hidden="true" class="hero-grid absolute inset-0 -z-10 opacity-80" />
            <h2 class="max-w-xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">{pick(project.ctaTitle, lang)}</h2>
            {project.ctaDescription && (
              <p class="mt-3 max-w-xl leading-relaxed text-muted">{pick(project.ctaDescription, lang)}</p>
            )}
            <a data-magnetic href={`${localePath("/", lang)}#contact`} class="btn btn-primary group mt-8">
              {t("project.ctaButton")}
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </aside>
        )
      }
    </article>
  </div>

  {nextProject && nextProject.slug !== project.slug && <NextProject project={nextProject} lang={lang} />}

  <Lightbox lang={lang} />
</BaseLayout>

<style>
  .cta-backdrop {
    background:
      radial-gradient(60% 90% at 0% 0%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(50% 80% at 100% 100%, color-mix(in oklab, var(--accent-2) 20%, transparent), transparent 70%),
      var(--glass);
  }
</style>
