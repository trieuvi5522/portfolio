---
import { getImage } from "astro:assets";
import type { Locale, Project } from "../../data/types";
import { projectImage } from "../../lib/images";
import { useTranslations, pick, localePath } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectHero from "../project/ProjectHero.astro";
import ProjectSection from "../project/ProjectSection.astro";
import ResultsList from "../project/ResultsList.astro";
import TechHighlights from "../project/TechHighlights.astro";
import Lightbox from "../project/Lightbox.astro";

interface Props {
  project: Project;
  lang: Locale;
}
const { project, lang } = Astro.props;
const t = useTranslations(lang);

const ogImage = await getImage({ src: projectImage(project.cover), width: 1200 });
---

<BaseLayout
  lang={lang}
  title={pick(project.title, lang)}
  description={pick(project.excerpt, lang)}
  ogImage={ogImage.src}
>
  <ProjectHero project={project} lang={lang} />

  <article class="mx-auto max-w-4xl space-y-14 px-4 py-12 sm:px-6 sm:py-16">
    {project.sections.map((section) => <ProjectSection section={section} lang={lang} />)}

    {project.techHighlights && project.techHighlights.length > 0 && (
      <TechHighlights highlights={project.techHighlights} lang={lang} />
    )}

    {project.results.length > 0 && (
      <ResultsList results={project.results} title={project.resultsTitle} lang={lang} />
    )}

    {
      project.ctaTitle && (
        <aside class="rounded-xl border border-accent/40 bg-accent-soft p-6 sm:p-8">
          <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">{pick(project.ctaTitle, lang)}</h2>
          {project.ctaDescription && <p class="mt-3 leading-relaxed text-muted">{pick(project.ctaDescription, lang)}</p>}
          <a
            href={`${localePath("/", lang)}#contact`}
            class="mt-5 inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90 dark:text-slate-900"
          >
            {t("project.ctaButton")}
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </aside>
      )
    }
  </article>

  <Lightbox />
</BaseLayout>
