---
import type { Locale } from "../../data/types";
import { useTranslations, localePath } from "../../i18n/utils";
import { aboutFocus, aboutSkills, aboutProcess, aboutWhy } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../SectionHeading.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const focus = aboutFocus[lang];
const skills = aboutSkills[lang];
const process = aboutProcess[lang];
const why = aboutWhy[lang];
---

<BaseLayout lang={lang} title={t("about.kicker")} description={t("about.intro1")}>
  {/* Intro */}
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent">{t("about.kicker")}</p>
      <h1 class="mt-3 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
        {t("about.greeting")}
      </h1>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-muted">
        <p>{t("about.intro1")}</p>
        <p>{t("about.intro2")}</p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-4xl space-y-16 px-4 py-12 sm:px-6 sm:py-16">
    {/* Focus areas */}
    <section>
      <SectionHeading title={t("about.focusTitle")} />
      <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          focus.map((item) => (
            <li class="flex items-start gap-3 rounded-lg border border-line bg-surface p-4">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <path d="m8.5 12.5 2.5 2.5 5-6" />
              </svg>
              <span class="text-sm font-medium leading-relaxed">{item}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {/* Technical expertise */}
    <section>
      <SectionHeading title={t("about.expertiseTitle")} />
      <ul class="mt-6 space-y-3">
        {
          skills.map((skill) => {
            const [head, ...rest] = skill.split(":");
            const tail = rest.join(":").trim();
            return (
              <li class="flex items-start gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                <p class="leading-relaxed text-muted">
                  {tail ? (
                    <>
                      <span class="font-medium text-fg">{head}:</span> {tail}
                    </>
                  ) : (
                    skill
                  )}
                </p>
              </li>
            );
          })
        }
      </ul>
    </section>

    {/* Process */}
    <section>
      <SectionHeading title={t("about.processTitle")} description={t("about.processSubtitle")} />
      <ol class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          process.map((step, i) => (
            <li class="rounded-lg border border-line bg-surface p-5">
              <span class="font-mono text-xs font-semibold text-accent">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-2 text-sm font-semibold">{step.title}</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-muted">{step.desc}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {/* Why work with me */}
    <section>
      <SectionHeading title={t("about.whyTitle")} />
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          why.map((item) => (
            <div class="rounded-lg border border-line bg-surface p-5">
              <h3 class="text-sm font-semibold text-accent">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    {/* CTA */}
    <section class="rounded-xl border border-accent/40 bg-accent-soft p-6 text-center sm:p-10">
      <h2 class="text-2xl font-semibold tracking-tight">{t("about.ctaTitle")}</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">{t("about.ctaDesc")}</p>
      <a
        href={localePath("/contact", lang)}
        class="mt-6 inline-flex items-center gap-2 rounded-md bg-accent px-6 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90 dark:text-slate-900"
      >
        {t("nav.contact")}
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </section>
  </div>
</BaseLayout>
