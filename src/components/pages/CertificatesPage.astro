---
import type { Locale } from "../../data/types";
import { certificateGroups } from "../../data/certificates";
import { useTranslations, pick } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../PageHero.astro";
import SectionHeading from "../SectionHeading.astro";
import CertificateCard from "../CertificateCard.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t("cert.title")} description={t("cert.desc")}>
  <PageHero kicker={t("cert.kicker")} title={t("cert.title")} description={t("cert.desc")} />

  <div class="mx-auto max-w-6xl space-y-24 px-4 pb-24 pt-4 sm:space-y-32 sm:px-6 sm:pb-32">
    {
      certificateGroups.map((group, i) => (
        <section class="grid gap-10 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-14">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <SectionHeading
              index={String(i + 1).padStart(2, "0")}
              title={pick(group.name, lang)}
              description={group.blurb ? pick(group.blurb, lang) : undefined}
            />
          </div>
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2" data-spotlight-group>
            {group.certificates.map((cert) => (
              <CertificateCard cert={cert} lang={lang} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
