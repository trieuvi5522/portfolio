---
import type { Locale } from "../data/types";
import { site, whatsappUrl, mailtoUrl } from "../data/site";
import { useTranslations, localePath } from "../i18n/utils";
import LogoMark from "./LogoMark.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const links = [
  { href: mailtoUrl, label: "Email" },
  { href: whatsappUrl, label: "WhatsApp" },
  { href: site.linkedinUrl, label: "LinkedIn" },
  { href: site.facebookUrl, label: "Facebook" },
];
---

<footer class="relative mt-auto overflow-hidden border-t border-line">
  <div class="mx-auto max-w-6xl px-4 pt-14 sm:px-6 sm:pt-16">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div>
        <a href={localePath("/", lang)} class="group inline-flex items-center gap-3">
          <LogoMark class="transition-transform duration-500 group-hover:-rotate-6" />
          <span class="font-display text-lg font-semibold tracking-tight">{site.ownerName}</span>
        </a>
        <p class="mt-3 text-sm text-muted">{t("footer.tagline")}</p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        {
          links.map((link) => {
            const external = link.href.startsWith("http");
            return (
              <a
                href={link.href}
                target={external ? "_blank" : undefined}
                rel={external ? "noreferrer" : undefined}
                class="btn btn-ghost btn-sm group"
              >
                {link.label}
                <svg class="h-3.5 w-3.5 text-muted transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 17 17 7M7 7h10v10" />
                </svg>
              </a>
            );
          })
        }
      </div>
    </div>

    {/* Oversized fading wordmark */}
    <div
      aria-hidden="true"
      data-parallax="0.3"
      class="footer-wordmark pointer-events-none mt-10 select-none whitespace-nowrap text-center font-display font-bold leading-[0.8] tracking-[-0.05em]"
    >
      {site.ownerName}
    </div>
  </div>

  <div class="relative border-t border-line bg-bg/40 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-5 text-xs text-muted sm:px-6">
      <span>© {year} {site.ownerName}. {t("footer.rights")}</span>
      <a href="#top" class="group inline-flex shrink-0 items-center gap-1.5 font-medium transition-colors hover:text-fg">
        {t("footer.backToTop")}
        <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:-translate-y-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 19V5M6 11l6-6 6 6" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-wordmark {
    font-size: clamp(3rem, 13.5vw, 10rem);
    margin-bottom: -0.12em;
    background: linear-gradient(to bottom, color-mix(in oklab, var(--fg) 16%, transparent) 10%, transparent 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
