---
import { Image } from "astro:assets";
import type { Locale, Project } from "../data/types";
import { projectImage } from "../lib/images";
import { useTranslations, pick, localePath, formatDate } from "../i18n/utils";
import TechBadge from "./TechBadge.astro";
import Flag from "./Flag.astro";

/** Large alternating "magazine" row used on the projects index */
interface Props {
  project: Project;
  lang: Locale;
  index: number;
}
const { project, lang, index } = Astro.props;
const t = useTranslations(lang);
const href = localePath(`/projects/${project.slug}`, lang);
const num = String(index).padStart(2, "0");
/** Even rows put the image on the right for an alternating rhythm */
const imageRight = index % 2 === 0;
/** Map the (stable) English location name to a flag code */
const flagByCountry: Record<string, string> = {
  Vietnam: "vn",
  Denmark: "dk",
  Germany: "de",
};
const flagCode = flagByCountry[project.location.en];
---

<article class="group grid grid-cols-1 items-center gap-6 sm:gap-10 md:grid-cols-2">
  <a
    href={href}
    tabindex="-1"
    aria-hidden="true"
    class:list={[
      "block overflow-hidden rounded-xl border border-line bg-surface transition-colors hover:border-accent",
      imageRight && "md:order-2",
    ]}
  >
    <Image
      src={projectImage(project.cover)}
      alt={pick(project.title, lang)}
      widths={[480, 768, 1024]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-[4/3] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </a>

  <div class:list={[imageRight && "md:order-1"]}>
    <div class="flex items-center gap-3">
      <span class="font-display text-4xl font-bold leading-none text-accent sm:text-5xl">{num}</span>
      <span class="h-px w-10 bg-accent/40" aria-hidden="true"></span>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
      <span class="inline-flex items-center gap-1.5 font-medium text-accent">
        {flagCode && <Flag code={flagCode} class="h-3.5 w-5" />}
        {pick(project.location, lang)}
      </span>
      <span aria-hidden="true">·</span>
      <time datetime={project.publishedAt}>{formatDate(project.publishedAt, lang)}</time>
      <span aria-hidden="true">·</span>
      <span>{pick(project.industry, lang)}</span>
    </div>

    <h3 class="mt-3 font-display text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">
      <a href={href} class="transition-colors group-hover:text-accent">{pick(project.title, lang)}</a>
    </h3>

    <p class="mt-4 max-w-xl leading-relaxed text-muted">{pick(project.excerpt, lang)}</p>

    <div class="mt-5 flex flex-wrap gap-1.5">
      {project.tech.map((tech) => <TechBadge label={tech} />)}
    </div>

    <a href={href} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent">
      {t("projects.readCase")}
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </div>
</article>
