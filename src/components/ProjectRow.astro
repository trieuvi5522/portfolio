---
import { Image } from "astro:assets";
import type { Locale, Project } from "../data/types";
import { projectImage } from "../lib/images";
import { useTranslations, pick, localePath, formatDate } from "../i18n/utils";
import TechBadge from "./TechBadge.astro";
import Flag from "./Flag.astro";

/** Large alternating "magazine" row used on the projects index */
interface Props {
  project: Project;
  lang: Locale;
  index: number;
}
const { project, lang, index } = Astro.props;
const t = useTranslations(lang);
const href = localePath(`/projects/${project.slug}`, lang);
const num = String(index).padStart(2, "0");
/** Even rows put the image on the right for an alternating rhythm */
const imageRight = index % 2 === 0;
/** Map the (stable) English country name to a flag code — "Vietnam / Global" uses the first one */
const flagByCountry: Record<string, string> = {
  Vietnam: "vn",
  Denmark: "dk",
  Germany: "de",
};
const flagCode = flagByCountry[project.location.en.split("/")[0].trim()];
/** Address shown in the faux browser bar */
const address = `${Astro.site?.host ?? ""}${href}`;
---

<article class="project-row group/row grid grid-cols-1 items-center gap-8 md:grid-cols-12 md:gap-12 lg:gap-16">
  <div data-reveal={imageRight ? "right" : "left"} class:list={["md:col-span-7", imageRight && "md:order-2"]}>
    <a href={href} tabindex="-1" aria-hidden="true" data-tilt="4" class="relative block">
      <div
        class="absolute -inset-5 -z-10 rounded-[2.5rem] opacity-0 blur-3xl transition-opacity duration-700 group-hover/row:opacity-40"
        style="background-image: var(--grad-accent)"
      >
      </div>
      <div class="window">
        <div class="window-bar">
          <span class="window-dot"></span>
          <span class="window-dot"></span>
          <span class="window-dot"></span>
          <span class="window-url">{address}</span>
        </div>
        <div class="window-screen" style={`view-transition-name: cover-${project.slug}`}>
          <Image
            src={projectImage(project.cover)}
            alt={pick(project.title, lang)}
            widths={[480, 768, 1024]}
            sizes="(min-width: 768px) 58vw, 100vw"
            data-parallax-img
            class="aspect-[16/10] w-full object-cover object-top"
          />
        </div>
      </div>
    </a>
  </div>

  <div data-reveal data-reveal-delay="0.12" class:list={["md:col-span-5", imageRight && "md:order-1"]}>
    <div class="flex items-center gap-4">
      <span class="row-number font-display text-6xl font-bold leading-none tracking-[-0.04em] sm:text-7xl">{num}</span>
      <span class="h-px flex-1 bg-gradient-to-r from-accent/50 to-transparent" aria-hidden="true"></span>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-2 text-xs">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-glass-border bg-glass px-2.5 py-1 font-medium">
        {flagCode && <Flag code={flagCode} class="h-3 w-[1.1rem]" />}
        {pick(project.location, lang)}
      </span>
      <span class="rounded-full border border-glass-border bg-glass px-2.5 py-1 text-muted">
        <time datetime={project.publishedAt}>{formatDate(project.publishedAt, lang)}</time>
      </span>
    </div>

    <p class="mt-5 font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent-strong">
      {pick(project.industry, lang)}
    </p>
    <h2 class="mt-2 text-2xl font-semibold leading-tight tracking-tight sm:text-3xl">
      <a href={href} class="title-link">{pick(project.title, lang)}</a>
    </h2>

    <p class="mt-4 leading-relaxed text-muted">{pick(project.excerpt, lang)}</p>

    <div class="mt-5 flex flex-wrap gap-1.5">
      {project.tech.map((tech) => <TechBadge label={tech} />)}
    </div>

    <a href={href} class="btn btn-ghost btn-sm group/cta mt-7">
      {t("projects.readCase")}
      <svg class="h-4 w-4 transition-transform duration-300 group-hover/cta:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  /* Outlined index number that fills with the accent gradient on hover */
  .row-number {
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--accent) 70%, transparent);
    background-image: var(--grad-accent);
    -webkit-background-clip: text;
    background-clip: text;
    background-size: 100% 0%;
    background-repeat: no-repeat;
    background-position: bottom;
    transition: background-size 0.7s var(--ease-out-expo);
  }
  .project-row:hover .row-number {
    background-size: 100% 100%;
  }

  /* Underline that draws in on hover */
  .title-link {
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0% 2px;
    background-repeat: no-repeat;
    background-position: left bottom;
    transition:
      background-size 0.6s var(--ease-out-expo),
      color 0.3s ease;
  }
  .title-link:hover,
  .project-row:hover .title-link {
    background-size: 100% 2px;
  }
</style>
