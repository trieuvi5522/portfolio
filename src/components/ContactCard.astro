---
/** Contact shortcut card: icon + label + value, optionally with a copy button */
interface Props {
  href: string;
  label: string;
  value: string;
  note?: string;
  external?: boolean;
  /** Show a copy-to-clipboard button for `value` (used for email) */
  copyable?: boolean;
  copyLabel?: string;
  copiedLabel?: string;
}
const { href, label, value, note, external = false, copyable = false, copyLabel = "Copy", copiedLabel = "Copied!" } = Astro.props;
---

<div data-reveal class="h-full">
  <div data-spotlight class="card card-hover group relative h-full">
    <a
      href={href}
      target={external ? "_blank" : undefined}
      rel={external ? "noreferrer" : undefined}
      class="flex h-full flex-col gap-5 rounded-[inherit] p-5"
    >
      <div class="flex items-start justify-between gap-3">
        <span class="inline-grid h-11 w-11 place-items-center rounded-xl bg-accent-soft text-accent ring-1 ring-accent/20 transition-transform duration-500 group-hover:scale-110">
          <slot name="icon" />
        </span>
        {
          !copyable && (
            <svg class="h-4 w-4 text-muted transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M7 7h10v10" />
            </svg>
          )
        }
      </div>
      <div class="min-w-0">
        <h3 class="text-sm font-semibold">{label}</h3>
        <p class="mt-0.5 truncate font-mono text-[0.8125rem] text-fg/80">{value}</p>
        {note && <p class="mt-2 text-xs leading-relaxed text-muted">{note}</p>}
      </div>
    </a>

    {
      copyable && (
        <button
          type="button"
          data-copy={value}
          data-copy-label={copyLabel}
          data-copied-label={copiedLabel}
          class="absolute right-4 top-4 rounded-full border border-glass-border bg-glass px-3 py-1 font-mono text-[0.6875rem] font-semibold text-muted transition-colors hover:border-accent/50 hover:text-accent"
        >
          {copyLabel}
        </button>
      )
    }
  </div>
</div>

<script>
  function initCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const value = btn.dataset.copy;
        if (!value) return;
        try {
          await navigator.clipboard.writeText(value);
          btn.textContent = btn.dataset.copiedLabel ?? "Copied!";
          setTimeout(() => {
            btn.textContent = btn.dataset.copyLabel ?? "Copy";
          }, 1600);
        } catch {
          /* clipboard unavailable — ignore */
        }
      });
    });
  }
  initCopyButtons();
</script>
