---
import type { Locale } from "../../data/types";
import { useTranslations } from "../../i18n/utils";

/**
 * Shared image lightbox. Render ONCE per page.
 * Any element with [data-lightbox-trigger] + data-full / data-alt / data-caption opens it;
 * arrows / ← → keys step through every trigger on the page.
 */
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<dialog id="lightbox" data-lenis-prevent class="lightbox m-0 h-dvh max-h-none w-screen max-w-none overflow-hidden bg-transparent p-0">
  <div data-lightbox-stage class="flex h-full w-full items-center justify-center px-3 py-6 sm:px-20 sm:py-10">
    <figure class="lightbox-figure window relative w-full max-w-6xl bg-surface">
      <div class="window-bar">
        <span class="window-dot"></span>
        <span class="window-dot"></span>
        <span class="window-dot"></span>
        <span data-lightbox-counter class="window-url text-center"></span>
        <button type="button" data-lightbox-close aria-label={t("lightbox.close")} class="icon-btn -my-1 h-8 w-8">
          <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
      <div class="window-screen">
        <img data-lightbox-img src="" alt="" class="max-h-[76vh] w-full object-contain" />
      </div>
      <figcaption data-lightbox-caption class="px-3 pb-1 pt-3 text-center text-sm text-muted"></figcaption>

      <button
        type="button"
        data-lightbox-prev
        aria-label={t("lightbox.prev")}
        class="icon-btn absolute left-2 top-1/2 h-10 w-10 -translate-y-1/2 bg-glass-strong sm:-left-16"
      >
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <button
        type="button"
        data-lightbox-next
        aria-label={t("lightbox.next")}
        class="icon-btn absolute right-2 top-1/2 h-10 w-10 -translate-y-1/2 bg-glass-strong sm:-right-16"
      >
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
    </figure>
  </div>
</dialog>

<style>
  .lightbox::backdrop {
    background: rgb(3 5 11 / 0.72);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .lightbox[open]::backdrop {
    animation: lightbox-fade 0.35s ease;
  }
  .lightbox[open] .lightbox-figure {
    animation: lightbox-in 0.6s var(--ease-out-expo);
  }
  @keyframes lightbox-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
  }
</style>

<script>
  function initLightbox() {
    const dialog = document.getElementById("lightbox");
    if (!(dialog instanceof HTMLDialogElement)) return;

    const stage = dialog.querySelector<HTMLElement>("[data-lightbox-stage]");
    const img = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const caption = dialog.querySelector<HTMLElement>("[data-lightbox-caption]");
    const counter = dialog.querySelector<HTMLElement>("[data-lightbox-counter]");
    const prev = dialog.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
    const next = dialog.querySelector<HTMLButtonElement>("[data-lightbox-next]");
    if (!stage || !img || !caption || !counter || !prev || !next) return;

    let triggers: HTMLElement[] = [];
    let index = 0;

    const show = (i: number, animate = true) => {
      index = (i + triggers.length) % triggers.length;
      const trigger = triggers[index];
      img.src = trigger.dataset.full ?? "";
      img.alt = trigger.dataset.alt ?? "";
      caption.textContent = trigger.dataset.caption ?? "";
      caption.hidden = !trigger.dataset.caption;
      counter.textContent = `${index + 1} / ${triggers.length}`;
      if (animate && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        img.animate([{ opacity: 0, transform: "scale(0.98)" }, { opacity: 1, transform: "none" }], {
          duration: 450,
          easing: "cubic-bezier(0.16, 1, 0.3, 1)",
        });
      }
    };

    const open = (trigger: HTMLElement) => {
      triggers = Array.from(document.querySelectorAll<HTMLElement>("[data-lightbox-trigger]"));
      const several = triggers.length > 1;
      prev.classList.toggle("hidden", !several);
      next.classList.toggle("hidden", !several);
      show(Math.max(0, triggers.indexOf(trigger)), false);
      dialog.showModal();
      window.__lenis?.stop();
    };

    document.addEventListener("click", (e) => {
      const trigger = (e.target as Element).closest<HTMLElement>("[data-lightbox-trigger]");
      if (trigger?.dataset.full) open(trigger);
    });
    dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
    prev.addEventListener("click", () => show(index - 1));
    next.addEventListener("click", () => show(index + 1));
    dialog.addEventListener("keydown", (e) => {
      if (triggers.length < 2) return;
      if (e.key === "ArrowLeft") show(index - 1);
      if (e.key === "ArrowRight") show(index + 1);
    });
    // Clicking the empty area around the image closes
    stage.addEventListener("click", (e) => {
      if (e.target === stage) dialog.close();
    });
    dialog.addEventListener("close", () => window.__lenis?.start());
  }
  initLightbox();
</script>
