---
import { Image } from "astro:assets";
import type { Locale, Project } from "../../data/types";
import { projectImage } from "../../lib/images";
import { useTranslations, pick, localePath } from "../../i18n/utils";

/** Teaser linking to the next case study; its cover morphs into that page's hero */
interface Props {
  project: Project;
  lang: Locale;
}
const { project, lang } = Astro.props;
const t = useTranslations(lang);
const href = localePath(`/projects/${project.slug}`, lang);
---

<section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6 sm:pb-32">
  <a href={href} data-reveal class="group block">
    <div data-spotlight class="card grid items-center gap-6 p-3 transition-[border-color] duration-500 group-hover:border-accent/40 sm:p-4 md:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] md:gap-10">
      <div class="p-3 sm:p-6">
        <p class="font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent-strong">
          {t("project.nextProject")}
        </p>
        <h2 class="mt-3 text-2xl font-semibold leading-tight tracking-tight text-balance sm:text-3xl">
          {pick(project.title, lang)}
        </h2>
        <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted">{pick(project.excerpt, lang)}</p>
        <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent-strong">
          {t("projects.readCase")}
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </span>
      </div>
      <div class="window-screen" style={`view-transition-name: cover-${project.slug}`}>
        <Image
          src={projectImage(project.cover)}
          alt=""
          widths={[480, 768]}
          sizes="(min-width: 768px) 480px, 100vw"
          class="aspect-[16/10] w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.04]"
        />
      </div>
    </div>
  </a>
</section>
