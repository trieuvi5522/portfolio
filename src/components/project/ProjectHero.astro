---
import type { Locale, Project } from "../../data/types";
import { useTranslations, pick, formatDate, localePath } from "../../i18n/utils";
import TechBadge from "../TechBadge.astro";

interface Props {
  project: Project;
  lang: Locale;
}
const { project, lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="border-b border-line bg-surface">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <a
      href={localePath("/projects", lang)}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-muted transition-colors hover:text-accent"
    >
      <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M11 18l-6-6 6-6"></path>
      </svg>
      {t("projects.backToProjects")}
    </a>

    <p class="mt-6 text-xs font-semibold uppercase tracking-widest text-accent">{pick(project.industry, lang)}</p>
    <h1 class="mt-3 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
      {pick(project.title, lang)}
    </h1>
    <p class="mt-4 max-w-2xl leading-relaxed text-muted">{pick(project.excerpt, lang)}</p>

    <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm">
      <div class="flex items-center gap-2">
        <dt class="text-muted">{t("project.location")}:</dt>
        <dd class="font-medium">{pick(project.location, lang)}</dd>
      </div>
      <div class="flex items-center gap-2">
        <dt class="text-muted">{t("project.published")}:</dt>
        <dd class="font-medium">
          <time datetime={project.publishedAt}>{formatDate(project.publishedAt, lang)}</time>
        </dd>
      </div>
    </dl>

    <div class="mt-5 flex flex-wrap gap-1.5">
      {project.tech.map((tech) => <TechBadge label={tech} />)}
    </div>
  </div>
</header>
