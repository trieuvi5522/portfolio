---
import { Image, getImage } from "astro:assets";
import type { GalleryImage, Locale } from "../../data/types";
import { projectImage } from "../../lib/images";
import { pick } from "../../i18n/utils";

interface Props {
  images: GalleryImage[];
  lang: Locale;
}
const { images, lang } = Astro.props;

/** Pre-render a large variant for the lightbox */
const items = await Promise.all(
  images.map(async (g) => {
    const meta = projectImage(g.src);
    const full = await getImage({ src: meta, width: Math.min(meta.width, 1600) });
    return { ...g, meta, fullSrc: full.src };
  })
);
---

<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
  {
    items.map((item) => (
      <figure data-reveal>
        <button
          type="button"
          data-lightbox-trigger
          data-full={item.fullSrc}
          data-alt={pick(item.alt, lang)}
          data-caption={item.caption ? pick(item.caption, lang) : undefined}
          class="group window block w-full cursor-zoom-in p-1.5 text-left transition-[border-color] duration-500 hover:border-accent/40"
        >
          <div class="window-screen">
            <Image
              src={item.meta}
              alt={pick(item.alt, lang)}
              widths={[480, 768]}
              sizes="(min-width: 640px) 380px, 100vw"
              class="aspect-[16/10] w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.04]"
            />
            <span class="zoom-badge" aria-hidden="true">
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
              </svg>
            </span>
          </div>
        </button>
        {item.caption && (
          <figcaption class="mt-3 px-1 text-center text-xs leading-relaxed text-muted">{pick(item.caption, lang)}</figcaption>
        )}
      </figure>
    ))
  }
</div>
