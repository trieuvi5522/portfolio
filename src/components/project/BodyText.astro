---
/**
 * Renders the body micro-format used by project content:
 * - lines starting with "- ", "• " or "* " become bullet list items
 * - blank lines separate paragraphs
 * - [label](https://url) becomes a link
 * Ported from the Luca IoT site's RenderBody/renderInlineLinks.
 */
interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;

const escapeHtml = (s: string) =>
  s
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");

/** Escape, then turn [label](url) into anchors */
const renderInline = (raw: string): string =>
  escapeHtml(raw).replace(
    /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
    (_m, label, url) => `<a href="${url}" target="_blank" rel="noreferrer" class="prose-link">${label}</a>`
  );

type Block = { type: "p"; html: string } | { type: "ul"; items: string[] };

const blocks: Block[] = [];
let currentList: string[] = [];

const flushList = () => {
  if (currentList.length > 0) {
    blocks.push({ type: "ul", items: currentList });
    currentList = [];
  }
};

for (const line of text.split("\n")) {
  const trimmed = line.trim();
  if (!trimmed) continue;
  if (/^[•*-]\s/.test(trimmed)) {
    currentList.push(renderInline(trimmed.replace(/^[•*-]\s*/, "")));
  } else {
    flushList();
    blocks.push({ type: "p", html: renderInline(trimmed) });
  }
}
flushList();
---

<div class:list={["space-y-4", className]}>
  {
    blocks.map((block) =>
      block.type === "ul" ? (
        <ul class="space-y-2.5">
          {block.items.map((item) => (
            <li class="flex items-start gap-3 leading-[1.75] text-body">
              <span class="mt-[0.7rem] h-1.5 w-1.5 shrink-0 rotate-45 rounded-[1px] bg-gradient-to-br from-accent to-accent-2" />
              <span set:html={item} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="leading-[1.8] text-body" set:html={block.html} />
      )
    )
  }
</div>
