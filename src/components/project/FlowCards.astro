---
import type { Locale, LocaleString, SectionCard } from "../../data/types";
import { pick } from "../../i18n/utils";

/** Arrow-connected architecture cards (e.g. Meter -> Node-RED -> InfluxDB -> Grafana) */
interface Props {
  cards: SectionCard[];
  flowLabel?: LocaleString;
  lang: Locale;
}
const { cards, flowLabel, lang } = Astro.props;
---

<div class="space-y-3">
  {
    flowLabel && (
      <p class="font-mono text-xs font-medium uppercase tracking-wider text-accent">
        {pick(flowLabel, lang).replaceAll("->", "→")}
      </p>
    )
  }
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:flex lg:items-stretch">
    {
      cards.map((card, i) => (
        <>
          <div class="flex-1 rounded-lg border border-line bg-surface p-4">
            <h4 class="text-sm font-semibold">{pick(card.title, lang)}</h4>
            <p class="mt-1.5 text-xs leading-relaxed text-muted">{pick(card.body, lang)}</p>
          </div>
          {i < cards.length - 1 && (
            <div class="hidden items-center text-muted lg:flex" aria-hidden="true">
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </div>
          )}
        </>
      ))
    }
  </div>
</div>
