---
import type { Locale, LocaleString, SectionCard } from "../../data/types";
import { pick } from "../../i18n/utils";

/**
 * Architecture flow: the flow label becomes a chip pipeline
 * (e.g. Meter -> Node-RED -> InfluxDB -> Grafana) and the cards a connected stepper.
 */
interface Props {
  cards: SectionCard[];
  flowLabel?: LocaleString;
  lang: Locale;
}
const { cards, flowLabel, lang } = Astro.props;
const steps = flowLabel ? pick(flowLabel, lang).split("->").map((step) => step.trim()) : [];
---

<div class="space-y-6">
  {
    steps.length > 0 && (
      <div data-reveal class="flex flex-wrap items-center gap-x-2 gap-y-2.5">
        {steps.map((step, i) => (
          <>
            <span class="rounded-lg border border-glass-border bg-glass px-3 py-1.5 font-mono text-xs font-medium text-fg shadow-sm">
              {step}
            </span>
            {i < steps.length - 1 && (
              <>
                <span class="flow-arrow" aria-hidden="true" />
                <span class="sr-only">→</span>
              </>
            )}
          </>
        ))}
      </div>
    )
  }

  <ol class="space-y-3" data-spotlight-group>
    {
      cards.map((card, i) => (
        <li data-reveal class="relative pl-12 sm:pl-14">
          <span class="absolute left-0 top-4 grid h-9 w-9 place-items-center rounded-xl border border-glass-border bg-glass-strong font-mono text-xs font-semibold text-accent shadow-sm">
            {String(i + 1).padStart(2, "0")}
          </span>
          {i < cards.length - 1 && <span class="flow-line left-[1.125rem] top-[3.25rem] -bottom-7" aria-hidden="true" />}
          <div data-spotlight class="card p-4 sm:p-5">
            <h3 class="text-sm font-semibold sm:text-base">{pick(card.title, lang)}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{pick(card.body, lang)}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>
