---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Locale, ProjectSection as ProjectSectionType } from "../../data/types";
import { projectImage } from "../../lib/images";
import { pick } from "../../i18n/utils";
import BodyText from "./BodyText.astro";
import FlowCards from "./FlowCards.astro";
import Gallery from "./Gallery.astro";

interface Props {
  section: ProjectSectionType;
  /** 1-based position, shown as the section number */
  index: number;
  lang: Locale;
}
const { section, index, lang } = Astro.props;

const body = pick(section.body, lang);

let image: { meta: ImageMetadata; fullSrc: string } | undefined;
if (section.image) {
  const meta = projectImage(section.image);
  const full = await getImage({ src: meta, width: Math.min(meta.width, 1600) });
  image = { meta, fullSrc: full.src };
}
---

<section id={section.id} class="scroll-mt-28">
  <div class="flex items-baseline gap-4">
    <span class="font-mono text-sm font-semibold text-accent" aria-hidden="true">{String(index).padStart(2, "0")}</span>
    <h2 data-split class="text-2xl font-semibold leading-tight tracking-[-0.025em] text-balance sm:text-3xl">
      {pick(section.title, lang)}
    </h2>
  </div>

  <div class="mt-6 space-y-8">
    {
      body && (
        <div data-reveal>
          <BodyText text={body} />
        </div>
      )
    }

    {section.cards && section.cards.length > 0 && (
      <FlowCards cards={section.cards} flowLabel={section.flowLabel} lang={lang} />
    )}

    {
      image && (
        <figure data-reveal>
          <button
            type="button"
            data-lightbox-trigger
            data-full={image.fullSrc}
            data-alt={section.imageAlt ? pick(section.imageAlt, lang) : ""}
            data-caption={section.imageCaption ? pick(section.imageCaption, lang) : undefined}
            class="group window block w-full cursor-zoom-in text-left transition-[border-color] duration-500 hover:border-accent/40"
          >
            <div class="window-screen">
              <Image
                src={image.meta}
                alt={section.imageAlt ? pick(section.imageAlt, lang) : ""}
                widths={[640, 1024, 1400]}
                sizes="(min-width: 1024px) 768px, 100vw"
                class="w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
              />
              <span class="zoom-badge" aria-hidden="true">
                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                </svg>
              </span>
            </div>
          </button>
          {section.imageCaption && (
            <figcaption class="mt-3 text-center text-xs leading-relaxed text-muted">{pick(section.imageCaption, lang)}</figcaption>
          )}
        </figure>
      )
    }

    {section.gallery && section.gallery.length > 0 && <Gallery images={section.gallery} lang={lang} />}
  </div>
</section>
