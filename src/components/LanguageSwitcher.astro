---
import type { Locale } from "../data/types";
import { switchLocalePath } from "../i18n/utils";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const pathname = Astro.url.pathname;

const options: { code: Locale; label: string }[] = [
  { code: "en", label: "EN" },
  { code: "vi", label: "VI" },
];
---

<div class="flex items-center overflow-hidden rounded-md border border-line text-xs font-medium">
  {
    options.map((opt) => (
      <a
        href={switchLocalePath(pathname, opt.code)}
        aria-current={opt.code === lang ? "true" : undefined}
        class:list={[
          "px-2.5 py-1.5 transition-colors",
          opt.code === lang
            ? "bg-accent-soft text-accent"
            : "text-muted hover:text-fg",
        ]}
      >
        {opt.label}
      </a>
    ))
  }
</div>
