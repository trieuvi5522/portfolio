---
import { Image } from "astro:assets";
import type { Locale } from "../data/types";
import type { Certificate } from "../data/certificates";
import { certImage } from "../lib/images";
import { useTranslations, formatDate } from "../i18n/utils";

interface Props {
  cert: Certificate;
  lang: Locale;
}
const { cert, lang } = Astro.props;
const t = useTranslations(lang);
const title = cert.title[lang] ?? cert.title.en;
// Some credentials only have a year (e.g. competition awards) — show it as-is.
const issuedText = /^\d{4}$/.test(cert.date) ? cert.date : formatDate(cert.date, lang);
// Clicking the preview opens the PDF when available, else the verify page.
const previewHref = cert.file ?? cert.verifyUrl;
---

<article class="group flex h-full flex-col overflow-hidden rounded-xl border border-line bg-surface transition-colors hover:border-accent">
  {
    cert.image && (
      <a
        href={previewHref}
        target="_blank"
        rel="noreferrer"
        class="block overflow-hidden border-b border-line bg-white"
        aria-label={title}
      >
        <Image
          src={certImage(cert.image)}
          alt={`${title} certificate`}
          widths={[320, 640, 960]}
          sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
          class="aspect-[4/3] w-full object-contain p-2 transition-transform duration-300 group-hover:scale-[1.02]"
        />
      </a>
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-base font-semibold leading-snug tracking-tight">{title}</h3>
    <p class="mt-1 text-sm text-muted">{cert.issuer}</p>

    <dl class="mt-4 space-y-1.5 text-xs text-muted">
      <div class="flex items-center gap-2">
        <dt class="font-medium text-fg">{t("cert.issued")}</dt>
        <dd><time datetime={cert.date}>{issuedText}</time></dd>
      </div>
      {
        cert.credentialId && (
          <div class="flex items-center gap-2">
            <dt class="font-medium text-fg">{t("cert.id")}</dt>
            <dd class="truncate font-mono">{cert.credentialId}</dd>
          </div>
        )
      }
    </dl>

    <div class="mt-5 flex flex-wrap gap-2 pt-1">
      {
        cert.file && (
          <a
            href={cert.file}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md bg-accent px-3 py-1.5 text-xs font-semibold text-white transition-opacity hover:opacity-90 dark:text-slate-900"
          >
            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
            {t("cert.view")}
          </a>
        )
      }
      {
        cert.verifyUrl && (
          <a
            href={cert.verifyUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-1.5 rounded-md border border-line px-3 py-1.5 text-xs font-semibold transition-colors hover:border-accent hover:text-accent"
          >
            {t("cert.verify")}
            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 7h10v10" />
              <path d="M7 17 17 7" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</article>
