---
import { Image } from "astro:assets";
import type { Locale } from "../data/types";
import type { Certificate } from "../data/certificates";
import { certImage } from "../lib/images";
import { useTranslations, formatDate } from "../i18n/utils";

interface Props {
  cert: Certificate;
  lang: Locale;
}
const { cert, lang } = Astro.props;
const t = useTranslations(lang);
const title = cert.title[lang] ?? cert.title.en;
// Some credentials only have a year (e.g. competition awards) — show it as-is.
const issuedText = /^\d{4}$/.test(cert.date) ? cert.date : formatDate(cert.date, lang);
// Clicking the preview opens the PDF when available, else the verify page.
const previewHref = cert.file ?? cert.verifyUrl;
---

<div data-reveal class="h-full">
  <div data-tilt="5" class="h-full">
    <article data-spotlight class="card card-hover group flex h-full flex-col p-2">
      {
        cert.image && (
          <a
            href={previewHref}
            target="_blank"
            rel="noreferrer"
            class="relative block overflow-hidden rounded-[0.95rem] border border-line bg-white"
            aria-label={title}
          >
            <Image
              src={certImage(cert.image)}
              alt={`${title} certificate`}
              widths={[320, 640, 960]}
              sizes="(min-width: 1024px) 26vw, (min-width: 640px) 45vw, 90vw"
              class="aspect-[4/3] w-full object-contain p-3 transition-transform duration-700 group-hover:scale-[1.03]"
            />
            {/* light sweep on hover */}
            <span
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/60 to-transparent transition-transform duration-1000 ease-out group-hover:translate-x-full"
            />
          </a>
        )
      }

      <div class="flex flex-1 flex-col p-4 pt-5">
        <h3 class="text-base font-semibold leading-snug tracking-tight">{title}</h3>
        <p class="mt-1 text-sm text-muted">{cert.issuer}</p>

        <dl class="mt-4 space-y-1.5 border-t border-line pt-4 font-mono text-xs text-muted">
          <div class="flex items-center justify-between gap-3">
            <dt>{t("cert.issued")}</dt>
            <dd class="text-fg"><time datetime={cert.date}>{issuedText}</time></dd>
          </div>
          {
            cert.credentialId && (
              <div class="flex items-center justify-between gap-3">
                <dt class="shrink-0">{t("cert.id")}</dt>
                <dd class="truncate text-fg">{cert.credentialId}</dd>
              </div>
            )
          }
        </dl>

        <div class="mt-auto flex flex-wrap gap-2 pt-5">
          {
            cert.file && (
              <a href={cert.file} target="_blank" rel="noreferrer" class="btn btn-primary btn-sm">
                <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
                {t("cert.view")}
              </a>
            )
          }
          {
            cert.verifyUrl && (
              <a href={cert.verifyUrl} target="_blank" rel="noreferrer" class="btn btn-ghost btn-sm">
                {t("cert.verify")}
                <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 7h10v10" />
                  <path d="M7 17 17 7" />
                </svg>
              </a>
            )
          }
        </div>
      </div>
    </article>
  </div>
</div>
