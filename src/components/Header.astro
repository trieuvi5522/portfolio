---
import type { Locale } from "../data/types";
import { site } from "../data/site";
import { useTranslations, localePath, stripLocale } from "../i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LogoMark from "./LogoMark.astro";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { href: "/", label: t("nav.home") },
  { href: "/projects", label: t("nav.projects") },
  { href: "/certificates", label: t("nav.certificates") },
];

const current = stripLocale(Astro.url.pathname);
const isActive = (href: string) =>
  href === "/" ? current === "/" : current === href || current.startsWith(`${href}/`);
---

<div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>

<header data-header class="pointer-events-none sticky top-0 z-50 px-3 pt-3 sm:px-4 sm:pt-4">
  <div class="header-pill pointer-events-auto mx-auto flex h-14 max-w-6xl items-center gap-3 rounded-2xl pl-2.5 pr-2 sm:pl-3">
    <a
      href={localePath("/", lang)}
      class="group flex shrink-0 items-center gap-2.5 rounded-xl pr-1"
    >
      <LogoMark class="transition-transform duration-500 group-hover:-rotate-6 group-hover:scale-105" />
      <span class="font-display text-[0.95rem] font-semibold tracking-tight">{site.ownerName}</span>
    </a>

    <nav data-nav class="relative mx-auto hidden items-center md:flex" aria-label="Main">
      <span data-nav-indicator class="nav-indicator" aria-hidden="true"></span>
      {
        navItems.map((item) => (
          <a
            href={localePath(item.href, lang)}
            data-nav-link
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "relative z-10 rounded-full px-4 py-2 text-sm font-medium transition-colors duration-300",
              isActive(item.href) ? "text-fg" : "text-muted hover:text-fg",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5 sm:gap-2 md:ml-0">
      <LanguageSwitcher lang={lang} />
      <ThemeToggle lang={lang} />
      <button
        type="button"
        data-menu-toggle
        aria-label={t("nav.menu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="icon-btn menu-toggle md:hidden"
      >
        <span class="menu-line menu-line--top"></span>
        <span class="menu-line menu-line--bottom"></span>
      </button>
    </div>
  </div>

  {/* Mobile menu */}
  <div
    id="mobile-menu"
    data-mobile-menu
    data-open="false"
    inert
    class="mobile-menu pointer-events-auto mx-auto max-w-6xl md:hidden"
  >
    <div class="min-h-0 overflow-hidden">
      <nav class="glass mt-2 flex flex-col gap-1 rounded-2xl p-2" aria-label="Mobile">
        {
          navItems.map((item, i) => (
            <a
              href={localePath(item.href, lang)}
              aria-current={isActive(item.href) ? "page" : undefined}
              style={`--i: ${i}`}
              class:list={[
                "mobile-link flex items-center justify-between rounded-xl px-4 py-3.5 text-base font-medium",
                isActive(item.href) ? "bg-accent-soft text-fg" : "text-muted",
              ]}
            >
              {item.label}
              <svg class="h-4 w-4 opacity-60" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<style>
  .header-pill {
    border: 1px solid var(--glass-border);
    background-color: var(--glass);
    box-shadow: inset 0 1px 0 0 var(--glass-highlight);
    -webkit-backdrop-filter: blur(18px) saturate(170%);
    backdrop-filter: blur(18px) saturate(170%);
    transition:
      background-color 0.5s ease,
      box-shadow 0.5s ease;
  }
  [data-header].is-scrolled .header-pill {
    background-color: var(--glass-strong);
    box-shadow: inset 0 1px 0 0 var(--glass-highlight), var(--shadow-card);
  }

  /* Pill that slides under the active / hovered nav link */
  .nav-indicator {
    position: absolute;
    top: 50%;
    left: 0;
    height: 2.25rem;
    translate: 0 -50%;
    border-radius: 9999px;
    border: 1px solid var(--glass-border);
    background: color-mix(in oklab, var(--fg) 6%, transparent);
    opacity: 0;
    transition:
      transform 0.5s var(--ease-out-expo),
      width 0.5s var(--ease-out-expo),
      opacity 0.3s ease;
  }

  .menu-toggle {
    position: relative;
  }
  .menu-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1rem;
    height: 1.5px;
    border-radius: 9999px;
    background: currentColor;
    transition: transform 0.45s var(--ease-out-expo);
  }
  .menu-line--top {
    transform: translate(-50%, calc(-50% - 3px));
  }
  .menu-line--bottom {
    transform: translate(-50%, calc(-50% + 3px));
  }
  [aria-expanded="true"] .menu-line--top {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  [aria-expanded="true"] .menu-line--bottom {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* Height animates via the 0fr -> 1fr grid trick */
  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ease-out-expo);
  }
  .mobile-menu[data-open="true"] {
    grid-template-rows: 1fr;
  }
  .mobile-link {
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.4s ease,
      transform 0.5s var(--ease-out-expo),
      color 0.3s ease;
    transition-delay: calc(var(--i) * 60ms);
  }
  [data-open="true"] .mobile-link {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  /** Scrolled state for the pill + reading progress bar */
  function initScrollState() {
    const header = document.querySelector<HTMLElement>("[data-header]");
    const bar = document.querySelector<HTMLElement>("[data-scroll-progress]");
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      header?.classList.toggle("is-scrolled", y > 12);
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar?.style.setProperty("--progress", String(max > 0 ? Math.min(1, y / max) : 0));
    };
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );
    update();
  }

  /** Slide the indicator to the hovered link, back to the active one on leave */
  function initNavIndicator() {
    const nav = document.querySelector<HTMLElement>("[data-nav]");
    const indicator = nav?.querySelector<HTMLElement>("[data-nav-indicator]");
    if (!nav || !indicator) return;

    const links = Array.from(nav.querySelectorAll<HTMLElement>("[data-nav-link]"));
    const active = links.find((link) => link.getAttribute("aria-current") === "page");

    const moveTo = (link: HTMLElement | undefined, instant = false) => {
      if (!link) {
        indicator.style.opacity = "0";
        return;
      }
      if (instant) indicator.style.transition = "none";
      indicator.style.width = `${link.offsetWidth}px`;
      indicator.style.transform = `translateX(${link.offsetLeft}px)`;
      indicator.style.opacity = "1";
      if (instant) {
        void indicator.offsetWidth; // commit the jump before re-enabling transitions
        indicator.style.transition = "";
      }
    };

    moveTo(active, true);
    links.forEach((link) => link.addEventListener("pointerenter", () => moveTo(link)));
    nav.addEventListener("pointerleave", () => moveTo(active));
    document.fonts?.ready.then(() => moveTo(active, true));
  }

  function initMobileMenu() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      menu.dataset.open = String(open);
      menu.inert = !open;
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => setOpen(menu.dataset.open !== "true"));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.dataset.open === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (menu.dataset.open === "true" && !(e.target as Element).closest("[data-header]")) setOpen(false);
    });
    matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }

  initScrollState();
  initNavIndicator();
  initMobileMenu();
</script>
