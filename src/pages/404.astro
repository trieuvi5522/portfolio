---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroBackdrop from "../components/HeroBackdrop.astro";
import { useTranslations, localePath } from "../i18n/utils";

const t = useTranslations("en");
---

<BaseLayout lang="en" title={t("notFound.title")} description={t("notFound.desc")}>
  <section class="relative isolate">
    <HeroBackdrop />
    <div class="mx-auto flex max-w-6xl flex-col items-center px-4 py-24 text-center sm:px-6 sm:py-32">
      <p
        data-reveal="scale"
        class="text-gradient font-display text-[clamp(7rem,26vw,15rem)] font-bold leading-[0.9] tracking-[-0.06em]"
      >
        404
      </p>
      <h1 data-split class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{t("notFound.title")}</h1>
      <p data-reveal class="mt-4 max-w-md text-muted">{t("notFound.desc")}</p>
      <div data-reveal data-reveal-delay="0.15" class="mt-9">
        <a data-magnetic href={localePath("/", "en")} class="btn btn-primary">
          {t("notFound.back")}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
