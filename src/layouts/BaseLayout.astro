---
import "../styles/global.css";
import type { Locale } from "../data/types";
import { site } from "../data/site";
import { switchLocalePath, useTranslations } from "../i18n/utils";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Aurora from "../components/Aurora.astro";

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Optional absolute or site-relative og:image URL */
  ogImage?: string;
}

const { lang, title, description, ogImage } = Astro.props;
const t = useTranslations(lang);

const siteUrl = Astro.site!;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, siteUrl);
const enUrl = new URL(switchLocalePath(pathname, "en"), siteUrl);
const viUrl = new URL(switchLocalePath(pathname, "vi"), siteUrl);
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl) : undefined;

const fullTitle = `${title} | ${site.ownerName}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    {/* Runs before first paint: theme (light is the default), background phase, and motion opt-in. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          if (localStorage.getItem("theme") === "dark") root.classList.add("dark");
        } catch (e) {}
        // The aurora's drift phase comes from the wall clock, so it continues seamlessly across pages.
        root.style.setProperty("--aurora-offset", -(Date.now() % 1200000) / 1000 + "s");
        // Hide scroll-reveal targets until the motion script takes over — undone if it never boots.
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root.classList.add("motion");
          setTimeout(() => {
            if (!root.classList.contains("motion-ready")) root.classList.remove("motion");
          }, 2500);
        }
        // Keep the header still during page transitions. The name is only set while a transition
        // runs: a permanent view-transition-name would make it a backdrop root and kill its blur.
        const pinHeader = (transition) => {
          const header = document.querySelector("[data-header]");
          if (!transition || !header) return;
          header.style.viewTransitionName = "site-header";
          transition.finished.finally(() => (header.style.viewTransitionName = ""));
        };
        addEventListener("pageswap", (e) => pinHeader(e.viewTransition));
        addEventListener("pagereveal", (e) => pinHeader(e.viewTransition));
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="vi" href={viUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "vi" ? "vi_VN" : "en_US"} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  </head>
  <body class="relative flex min-h-screen flex-col overflow-x-clip">
    <a
      href="#main"
      class="sr-only rounded-full bg-fg px-4 py-2 text-sm font-semibold text-bg focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70]"
    >
      {t("nav.skip")}
    </a>
    <Aurora />
    <Header lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
